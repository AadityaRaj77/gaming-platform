datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TeamRole {
  LEADER
  MEMBER
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SocialProvider {
  TWITCH
  YOUTUBE
  TWITTER
  INSTAGRAM
  DISCORD
  FACEBOOK
  OTHER
}

enum VenueType {
  ONLINE
  OFFLINE
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum FeeType {
  FREE
  PAID
}

enum FormFieldType {
  TEXT
  NUMBER
  ALPHABET
  CHARACTER
  MULTI_SELECT
  PAYMENT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChatRoomType {
  TEAM
  TOURNAMENT
  DIRECT
}

model Game {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  name      String
  iconUrl   String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  teams           Team[]
  tournamentGames TournamentGame[]
  registrations   TournamentRegistration[]
  playerGames     PlayerGame[]
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  email        String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile PlayerProfile?

  teamMemberships TeamMember[]
  teamJoinRequests TeamJoinRequest[]

  createdTournaments     Tournament[] @relation("UserCreatedTournaments")
  organizerIn            TournamentOrganizer[]
  tournamentParticipants TournamentRegistration[]

  chatRooms   ChatMember[]
  messages    ChatMessage[]
}

model PlayerProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  location          String?
  gender            Gender?
  age               Int?
  about             String? @db.Text
  hoursPerWeek      Int?
  lookingForTeam    Boolean @default(false)

  availabilityStart String?
  availabilityEnd   String?

  isProfileComplete Boolean @default(false)
  visibility        String  @default("PUBLIC")

  games        PlayerGame[]
  socialLinks  SocialLink[]
  achievements Achievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerGame {
  id        Int @id @default(autoincrement())
  profileId Int
  gameId    Int

  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  game    Game          @relation(fields: [gameId], references: [id])

  inGameName String?
  playerTag  String?
  isPublic   Boolean @default(true)

  @@unique([profileId, gameId])
  @@index([gameId])
}

model SocialLink {
  id        Int @id @default(autoincrement())
  profileId Int
  provider  SocialProvider
  url       String
  label     String?

  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, provider])
}

model Achievement {
  id        Int @id @default(autoincrement())
  profileId Int

  profile PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  achievedAt  DateTime?
  proofUrl    String?

  createdAt DateTime @default(now())
}

model Team {
  id Int @id @default(autoincrement())

  name   String @unique
  gameId Int

  game Game @relation(fields: [gameId], references: [id])

  tagline String?
  region  String?

  maxMembers Int @default(5)

  members      TeamMember[]
  joinRequests TeamJoinRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
}

model TeamMember {
  id Int @id @default(autoincrement())

  teamId Int
  userId Int

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamJoinRequest {
  id Int @id @default(autoincrement())

  teamId Int
  userId Int

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String?
  status  RequestStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

model Tournament {
  id Int @id @default(autoincrement())

  name      String
  tagline   String?
  bannerUrl String?

  venueType VenueType
  location  String?

  startDate DateTime
  endDate   DateTime

  shareSlug String? @unique

  createdBy Int
  creator   User @relation("UserCreatedTournaments", fields: [createdBy], references: [id])

  status TournamentStatus @default(DRAFT)

  feeType   FeeType
  feeAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games         TournamentGame[]
  requirements  TournamentRequirement[]
  organizers    TournamentOrganizer[]
  participants  TournamentRegistration[]
  formFields    TournamentFormField[]

  @@index([createdBy])
}

model TournamentGame {
  id           Int @id @default(autoincrement())
  tournamentId Int
  gameId       Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  game       Game       @relation(fields: [gameId], references: [id])

  @@unique([tournamentId, gameId])
}

model TournamentRequirement {
  id           Int @id @default(autoincrement())
  tournamentId Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  text String
}

model TournamentOrganizer {
  id           Int @id @default(autoincrement())
  tournamentId Int
  userId       Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentFormField {
  id           Int @id @default(autoincrement())
  tournamentId Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  label         String
  fieldType     FormFieldType
  required      Boolean @default(true)
  allowMultiple Boolean @default(false)
  defaultValue  String?
  paymentMeta   Json?

  createdAt DateTime @default(now())
}

model TournamentRegistration {
  id           Int @id @default(autoincrement())
  tournamentId Int
  userId       Int
  gameId       Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game       @relation(fields: [gameId], references: [id])

  responses   Json
  paymentInfo Json?

  createdAt DateTime @default(now())

  @@unique([tournamentId, userId, gameId])
  @@index([tournamentId])
  @@index([userId])
}

model ChatRoom {
  id Int @id @default(autoincrement())

  type ChatRoomType

  teamId       Int?
  tournamentId Int?

  members ChatMember[]
  messages ChatMessage[]

  createdAt DateTime @default(now())
}

model ChatMember {
  id Int @id @default(autoincrement())

  roomId Int
  userId Int

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model ChatMessage {
  id Int @id @default(autoincrement())

  roomId   Int
  senderId Int

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content   String @db.Text
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}
